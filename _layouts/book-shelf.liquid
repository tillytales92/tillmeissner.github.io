---
layout: page
---
{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {% if page.shelves %}
      {% for group in page.shelves %}
        <h2 class="shelf-group">{{ group.heading }}</h2>
        {% for shelf in group.sections %}
          {% assign books = collection | where: 'shelf', shelf.id | sort: 'date' | reverse %}
          {% if books.size > 0 %}
            <h3 class="shelf-section" id="{{ shelf.id }}">
              {{ shelf.title }}
              <small class="text-muted">({{ books.size }})</small>
            </h3>
            <div class="shelf">
              {% for item in books %}
                {% include book_cover.liquid item=item %}
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% else %}
      {% for item in collection reversed %}
        {% assign current_year = item.date | date: '%Y' %}
        {% if current_year != year %}
          <h1 id="y{{ current_year }}">{{ current_year }}</h1>
          {% assign year = current_year %}
        {% endif %}
        {% include book_cover.liquid item=item %}
      {% endfor %}
    {% endif %}
  {% endif %}
{% endif %}
